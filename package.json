{
  "name": "@mageme/webforms-mcp",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "description": "MCP server for the MageMe WebForms management API (Magento 2, OAuth 1.0a)",
  "keywords": [
    "mcp",
    "magento",
    "magento2",
    "webforms",
    "mageme",
    "claude"
  ],
  "homepage": "https://github.com/mageme/webforms-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mageme/webforms-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mageme/webforms-mcp/issues"
  },
  "bin": {
    "webforms-mcp": "dist/start.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
